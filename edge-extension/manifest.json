{
  "manifest_version": 3,
  "name": "Quizzers – MCQ Answer Highlighter for Microsoft Edge",
  "short_name": "Quizzers",
  "version": "1.0.0",
  "description": "Finds visible multiple-choice questions on course pages, asks an OpenRouter model, and highlights the suggested answer in Edge. Never clicks for you.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://ocw.mit.edu/*",
    "https://openlearninglibrary.mit.edu/*",
    "https://*.mitxonline.mit.edu/*",
    "https://*.coursera.org/*",
    "https://*.edx.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ocw.mit.edu/*",
        "https://openlearninglibrary.mit.edu/*",
        "https://*.mitxonline.mit.edu/*",
        "https://*.coursera.org/*",
        "https://*.edx.org/*"
      ],
      "js": [
        "lib/config.js",
        "lib/errors.js",
        "lib/settings.js",
        "content/guards.js",
        "content/text.js",
        "content/parser.js",
        "content/completeness.js",
        "content/highlighter.js",
        "content/ui.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Quizzers",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "commands": {
    "scan-page": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Scan the current page for multiple-choice questions"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
